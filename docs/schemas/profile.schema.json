{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migrawin.local/schemas/profile.schema.json",
  "title": "MigraWin backup profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "preset", "destination", "scope", "applications"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "preset": {
      "type": "string",
      "enum": ["InventoryOnly", "SettingsOnly", "DataOnly", "PackageOnly", "SettingsAndData", "FullSupported", "Custom"]
    },
    "destination": { "type": "string" },
    "scope": { "type": "string", "enum": ["Full", "Incremental", "Differential"] },
    "keepLastSnapshots": { "type": "integer", "minimum": 0 },
    "scheduleEnabled": { "type": "boolean" },
    "scheduleTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "includeNewApplications": { "type": "boolean" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["installationId", "productId", "displayName"],
        "properties": {
          "installationId": { "type": "string", "minLength": 1 },
          "productId": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "backupInstaller": { "type": "boolean" },
          "backupSettings": { "type": "boolean" },
          "backupData": { "type": "boolean" },
          "backupInstalledFiles": { "type": "boolean" },
          "backupCache": { "type": "boolean" },
          "backupSensitiveSettings": { "type": "boolean" },
          "installerPath": { "type": "string" },
          "customDataRoots": {
            "type": "array",
            "items": { "type": "string" }
          },
          "excludedDataRoots": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
