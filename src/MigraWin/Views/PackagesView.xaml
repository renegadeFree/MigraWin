<UserControl x:Class="MigraWin.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Libreria dei pacchetti" Style="{StaticResource TitleText}" />
                <TextBlock Text="Importa installer posseduti, controlla hash e firma, associandoli alle applicazioni corrette."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Rimuovi dal catalogo" Style="{StaticResource DangerButton}"
                        Command="{Binding RemovePackageCommand}" Margin="0,0,8,0" />
                <Button Content="Importa installer" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ImportPackageCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SubtleCardBorder}" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource SymbolText}"
                           Foreground="{DynamicResource AppWarningBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Integrità non significa autorizzazione" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="Un hash conferma che il file non è cambiato rispetto all'importazione. La firma viene rilevata, ma l'esecuzione richiede sempre la tua approvazione."
                               Style="{StaticResource MutedText}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SelectedApplication.DisplayName, StringFormat='App selezionata: {0}'}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           Visibility="{Binding HasSelectedApplication, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="18,14" Visibility="{Binding Packages.Count, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="Installer importati" Style="{StaticResource SubtitleText}" />
                    <TextBlock Text="{Binding Packages.Count, StringFormat='{}{0} pacchetti'}"
                               HorizontalAlignment="Right" Style="{StaticResource CaptionText}" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                         ItemContainerStyle="{StaticResource AppListViewItem}" Margin="14,0,14,14"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8"
                                        Background="{DynamicResource AppSelectionBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource SymbolText}"
                                               Foreground="{DynamicResource AppAccentBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Sha256}" FontFamily="Consolas" FontSize="10"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource BodyStrongText}" />
                                    <TextBlock Text="{Binding SignatureLabel}" Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="Usa per l'app selezionata"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.AssignPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Packages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE7B8;" Style="{StaticResource SymbolText}" FontSize="42"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nessun installer importato" Style="{StaticResource SubtitleText}"
                               HorizontalAlignment="Center" Margin="0,12,0,5" />
                    <TextBlock Text="Importa un pacchetto e associalo a un'applicazione selezionata."
                               Style="{StaticResource MutedText}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
