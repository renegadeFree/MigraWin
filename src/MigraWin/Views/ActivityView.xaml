<UserControl x:Class="MigraWin.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Attività e rapporti" Style="{StaticResource TitleText}" />
                <TextBlock Text="Avanzamento, errori e rapporti esportabili in Markdown e JSON."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Aggiorna" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshReportCommand}" Margin="0,0,8,0" />
                <Button Content="Apri cartella rapporti" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenReportsFolderCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="390" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Cronologia sessione" Style="{StaticResource SubtitleText}" Margin="0,0,0,12" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Activities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource SymbolText}" FontSize="14"
                                                   Foreground="{DynamicResource AppAccentBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding TimeLabel}" HorizontalAlignment="Right"
                                                           Style="{StaticResource CaptionText}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="18,14" BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Ultimo rapporto" Style="{StaticResource SubtitleText}" />
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right">
                                <TextBlock Text="Markdown" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBox Grid.Row="1" Text="{Binding ReportText}" IsReadOnly="True"
                             AutomationProperties.Name="Contenuto ultimo rapporto"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                             BorderThickness="0" Padding="18" FontFamily="Cascadia Mono"
                             FontSize="12" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
