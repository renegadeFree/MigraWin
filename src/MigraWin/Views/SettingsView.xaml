<UserControl x:Class="MigraWin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="Impostazioni" Style="{StaticResource TitleText}" />
            <TextBlock Text="Preferenze locali senza account e senza invio di contenuti a servizi esterni."
                       Style="{StaticResource MutedText}" Margin="0,4,0,18" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Aggiornamenti" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="{Binding UpdateVersionLabel}" Style="{StaticResource BodyStrongText}"
                                   Margin="0,8,0,3" />
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" MaxWidth="520" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Controlla" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0" />
                        <Button Content="Scarica e installa" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallUpdateCommand}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Aspetto" Style="{StaticResource SubtitleText}" />
                    <TextBlock Text="Il tema segue Windows per impostazione iniziale; le risorse ad alto contrasto hanno precedenza."
                               Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                    <ComboBox SelectedIndex="{Binding ThemeChoiceIndex}" Width="260" HorizontalAlignment="Left"
                              AutomationProperties.Name="Tema dell'applicazione">
                        <ComboBoxItem Content="Segui il sistema" />
                        <ComboBoxItem Content="Chiaro" />
                        <ComboBoxItem Content="Scuro" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Inventario" Style="{StaticResource SubtitleText}" />
                    <CheckBox Content="Includi applicazioni Microsoft Store e MSIX"
                              IsChecked="{Binding IncludeStoreApps}" Margin="0,14,0,7" />
                    <TextBlock Text="La scansione legge metadati dei pacchetti installati. Non avvia programmi, script o installer."
                               Style="{StaticResource MutedText}" />
                    <CheckBox Content="Includi script e strumenti personali"
                              IsChecked="{Binding IncludePersonalScripts}" Margin="0,12,0,7" />
                    <TextBlock Text="Rileva script nella cartella utente e strumenti locali come PM2, n8n, Pi Agent e proxy Codex. I processi non vengono avviati."
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Dati locali" Style="{StaticResource SubtitleText}" />
                    <TextBlock Text="Profili, catalogo pacchetti e rapporti dell'ultima operazione restano su questo PC. Le password non vengono archiviate."
                               Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                    <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True"
                             AutomationProperties.Name="Cartella dati locale" />
                    <TextBlock Text="Rapporti: Documenti\MigraWin\Reports"
                               Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SubtleCardBorder}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource BodyStrongText}" />
                        <TextBlock Text="Avvio come utente normale. Le operazioni che richiedono privilegi elevati devono passare da un installer o da un'azione esplicita del sistema."
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="Apri cartella rapporti" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenReportsFolderCommand}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
