<UserControl x:Class="MigraWin.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

                <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Scegli cosa migrare" Style="{StaticResource TitleText}" />
                <TextBlock Text="La selezione è per applicazione e per componente. I giochi non possono essere inclusi automaticamente."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Aggiungi portabile" Style="{StaticResource GhostButton}"
                        Command="{Binding AddPortableApplicationCommand}" Margin="0,0,8,0" />
                <Button Content="Seleziona risultati" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectAllFilteredCommand}" Margin="0,0,8,0" />
                <Button Content="Deseleziona tutto" Style="{StaticResource GhostButton}"
                        Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                <Button Content="Analizza PC" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AnalyzeCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,18,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Cerca applicazioni"
                             ToolTip="Cerca per nome, produttore o versione" />
                    <TextBlock Text="Cerca per nome, produttore o versione…" IsHitTestVisible="False"
                               Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox Grid.Column="1" SelectedIndex="{Binding ApplicationFilterIndex}"
                          AutomationProperties.Name="Filtro applicazioni">
                    <ComboBoxItem Content="Tutte le applicazioni" />
                    <ComboBoxItem Content="Reinstallabili o supportate" />
                    <ComboBoxItem Content="Solo rilevate" />
                    <ComboBoxItem Content="Giochi esclusi" />
                    <ComboBoxItem Content="Nella selezione" />
                </ComboBox>
                <Grid Grid.Column="2" Width="180" Margin="12,0,0,0">
                    <ComboBox ItemsSource="{Binding Profiles}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="Profilo salvato"
                              SelectedItem="{Binding SelectedProfile}" />
                    <TextBlock Text="Nessun profilo salvato" Margin="11,0,28,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{DynamicResource AppTextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="3" Content="Carica profilo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadProfileCommand}" Margin="8,0,0,0" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Salva profilo" Style="{StaticResource SecondaryButton}"
                            Command="{Binding SaveProfileCommand}" Margin="0,0,8,0" />
                    <Button Content="Esporta" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportProfileCommand}" Margin="0,0,4,0" />
                    <Button Content="Importa" Style="{StaticResource GhostButton}"
                            Command="{Binding ImportProfileCommand}" />
                    <Button Content="Rimuovi pianificazione" Style="{StaticResource GhostButton}"
                            Command="{Binding RemoveScheduleCommand}" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" MinWidth="330" MaxWidth="450" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,9">
                    <TextBlock Text="{Binding SelectedAppsSummary}" Style="{StaticResource BodyStrongText}" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionText}"
                               Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </Grid>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding ApplicationsView}"
                         SelectedItem="{Binding SelectedApplication}"
                         ItemContainerStyle="{StaticResource AppListViewItem}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsGame, Converter={StaticResource InverseBoolean}}"
                                          VerticalAlignment="Center" ToolTip="Includi nel backup" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Publisher}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Version}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Architecture}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource CaptionText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="3" Style="{StaticResource Pill}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SupportLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
                <Grid>
                    <StackPanel Visibility="{Binding HasSelectedApplication, Converter={StaticResource InverseBoolToVisibility}}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="270">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource SymbolText}" FontSize="38"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Seleziona un'applicazione" Style="{StaticResource SubtitleText}"
                                   HorizontalAlignment="Center" Margin="0,12,0,5" />
                        <TextBlock Text="Qui puoi personalizzare esattamente quali componenti includere."
                                   Style="{StaticResource MutedText}" TextAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedApplication, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedApplication.DisplayName}"
                                       Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedApplication.Publisher}"
                                       Style="{StaticResource MutedText}" Margin="0,3,0,14" />
                            <Border Style="{StaticResource SubtleCardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Livello di supporto" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding SelectedApplication.Architecture}"
                                                   HorizontalAlignment="Right" Style="{StaticResource CaptionText}" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedApplication.SupportLabel}"
                                               Style="{StaticResource BodyStrongText}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SelectedApplication.SourceDetail}"
                                               Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Componenti" Style="{StaticResource BodyStrongText}" Margin="0,0,0,10" />
                            <CheckBox Content="Impostazioni e preferenze"
                                      IsChecked="{Binding SelectedApplication.BackupSettings}"
                                      IsEnabled="{Binding SelectedApplication.HasSettings}" Margin="0,0,0,10" />
                            <CheckBox Content="Dati, progetti e cartelle personalizzate"
                                      IsChecked="{Binding SelectedApplication.BackupData}"
                                      IsEnabled="{Binding SelectedApplication.HasData}" Margin="0,0,0,10" />
                            <CheckBox Content="Pacchetto installabile offline"
                                      IsChecked="{Binding SelectedApplication.BackupInstaller}"
                                      IsEnabled="{Binding SelectedApplication.HasInstaller}" Margin="0,0,0,10" />
                            <CheckBox Content="Copia archivistica dei file installati"
                                      IsChecked="{Binding SelectedApplication.BackupInstalledFiles}"
                                      IsEnabled="{Binding SelectedApplication.HasInstalledFiles}" Margin="0,0,0,10" />
                            <CheckBox Content="Includi configurazioni che possono contenere segreti"
                                      IsChecked="{Binding SelectedApplication.BackupSensitiveSettings}"
                                      Margin="0,0,0,10" />
                            <TextBlock Text="Cache e file temporanei sono esclusi in questa versione."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Margin="0,0,0,14" />

                            <TextBlock Text="Cartelle dati aggiuntive" Style="{StaticResource BodyStrongText}"
                                       Margin="0,4,0,7" />
                            <ItemsControl ItemsSource="{Binding SelectedApplication.CustomDataRoots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,5"
                                                   ToolTip="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Aggiungi cartella…" Style="{StaticResource GhostButton}"
                                    Command="{Binding AddCustomFolderCommand}"
                                    HorizontalAlignment="Left" Padding="8,4" Margin="0,1,0,14" />

                            <TextBlock Text="Esclusioni persistenti" Style="{StaticResource BodyStrongText}"
                                       Margin="0,4,0,7" />
                            <ItemsControl ItemsSource="{Binding SelectedApplication.ExcludedDataRoots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,5"
                                                   ToolTip="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,14">
                                <Button Content="Escludi cartella…" Style="{StaticResource GhostButton}"
                                        Command="{Binding AddExclusionCommand}" Padding="8,4" />
                                <Button Content="Azzera" Style="{StaticResource GhostButton}"
                                        Command="{Binding ClearExclusionsCommand}" Padding="8,4" />
                            </StackPanel>

                            <TextBlock Text="Installer associato" Style="{StaticResource BodyStrongText}"
                                       Margin="0,0,0,7" />
                            <TextBox Text="{Binding SelectedApplication.InstallerPath}" IsReadOnly="True"
                                     AutomationProperties.Name="Installer associato"
                                     ToolTip="{Binding SelectedApplication.InstallerPath}" Margin="0,0,0,8" />
                            <Button Content="Scegli installer…" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseInstallerCommand}" HorizontalAlignment="Left" />

                            <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="7"
                                    Padding="12" Margin="0,18,0,0">
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="Un file di configurazione può contenere token o password. MigraWin non dichiara trasferibile un segreto non verificato." />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
