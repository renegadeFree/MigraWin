<Window x:Class="MigraWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MigraWin.Views"
        Title="MigraWin"
        Width="1360" Height="860" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ThemeMode="System"
        Loaded="Window_OnLoaded"
        SizeChanged="Window_OnSizeChanged"
        Closed="Window_OnClosed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource AppBaseBrush}"
                BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="20,16,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/MigraWinMark.png" Width="40" Height="40"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="MigraWin" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Backup e migrazione" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="1" Style="{StaticResource NavList}"
                         SelectedIndex="{Binding NavigationIndex, Mode=TwoWay}">
                    <ListBoxItem AutomationProperties.Name="Panoramica" ToolTip="Panoramica">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource SymbolText}" Margin="0,0,12,0" />
                            <TextBlock Text="Panoramica" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Inventario" ToolTip="Inventario">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource SymbolText}" Margin="0,0,12,0" />
                            <TextBlock Text="Inventario" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Backup" ToolTip="Backup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource SymbolText}" Margin="0,0,12,0" />
                            <TextBlock Text="Backup" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Archivio" ToolTip="Archivio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource SymbolText}" Margin="0,0,12,0" />
                            <TextBlock Text="Archivio" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Confronto" ToolTip="Confronto">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" Style="{StaticResource SymbolText}" Margin="0,0,12,0" />
                            <TextBlock Text="Confronto" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Ripristino" ToolTip="Ripristino">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource SymbolText}" Margin="0,0,12,0" />
                            <TextBlock Text="Ripristino" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Pacchetti" ToolTip="Pacchetti">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource SymbolText}" Margin="0,0,12,0" />
                            <TextBlock Text="Pacchetti" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Attività" ToolTip="Attività">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource SymbolText}" Margin="0,0,12,0" />
                            <TextBlock Text="Attività" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Impostazioni" ToolTip="Impostazioni">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource SymbolText}" Margin="0,0,12,0" />
                            <TextBlock Text="Impostazioni" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <Border x:Name="SidebarFooter" Grid.Row="2" Margin="16" Padding="12"
                        BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1"
                        CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AppSuccessBrush}"
                                     Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Elaborazione locale" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource CaptionText}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource AppBaseBrush}"
                    BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <Border Style="{StaticResource Pill}" Margin="12,0,0,0" Padding="7,2">
                            <TextBlock Text="Solo locale" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource SymbolText}" FontSize="14"
                                   Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Verifica autenticata attiva" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="1" Value="{Binding ProgressValue}" Maximum="100"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer Grid.Row="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          Background="{DynamicResource AppWindowBrush}">
                <Grid MinWidth="840">
                    <views:OverviewView Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:InventoryView Visibility="{Binding IsInventoryPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:BackupView Visibility="{Binding IsBackupPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:ArchiveView Visibility="{Binding IsArchivePage, Converter={StaticResource BoolToVisibility}}" />
                    <views:ComparisonView Visibility="{Binding IsComparisonPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:RestoreView Visibility="{Binding IsRestorePage, Converter={StaticResource BoolToVisibility}}" />
                    <views:PackagesView Visibility="{Binding IsPackagesPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:ActivityView Visibility="{Binding IsActivityPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:SettingsView Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource AppBaseBrush}"
                    BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE946;" Style="{StaticResource SymbolText}" FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="900" />
                    </StackPanel>
                    <Button Content="Annulla" Style="{StaticResource GhostButton}"
                            Command="{Binding CancelCommand}" HorizontalAlignment="Right"
                            MinHeight="26" Padding="8,1" Margin="0,3,0,3"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
